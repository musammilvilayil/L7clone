# Copy to .env (local) or .env.production (build) and adjust.
# Every value here is public: anything prefixed VITE_ is compiled into the
# browser bundle. Never put secrets, API keys or tokens in these variables.

# Canonical origin used for canonical URLs, Open Graph URLs, JSON-LD and the
# sitemap. No trailing slash. The current live site uses the www host.
VITE_SITE_URL=https://www.ladder7.in

# Origin that still serves pages this redesign does not contain yet (product
# detail pages, blogs, careers, Education division, corporate training...).
# Links to those pages are built from this value. See SETUP_AND_DEPLOYMENT.md
# ("Pages not included in this release") before switching DNS to this site.
VITE_LEGACY_SITE_URL=https://www.ladder7.in

# WhatsApp number (digits only, with country code) that enquiry forms open.
VITE_WHATSAPP_NUMBER=918137979401

# Optional: an HTTPS endpoint that receives a JSON copy of each enquiry
# ({ name, email, interest, message, source, page }) before WhatsApp opens.
# Leave empty to use the WhatsApp hand-off only (the design's behaviour).
VITE_ENQUIRY_ENDPOINT=

# Set to "false" on staging/preview builds: every page gets
# <meta name="robots" content="noindex"> and robots.txt disallows crawling.
VITE_ALLOW_INDEXING=true
