              },
              {
                "@type": "Question",
                "name": "What is the time difference between India and the UK?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "India is 5.5 hours ahead of the UK in winter and 4.5 hours ahead in summer, leaving a shared window from your morning to our evening."
                }
              },
              {
                "@type": "Question",
                "name": "Can you help with European Accessibility Act requirements?",
                "acceptedAnswer": {
                  "@type": "Answer",
